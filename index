        }
        .review-word-btn {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fca5a5;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.92em;
            font-weight: 600;
            cursor: pointer;
        }
        .review-word-btn:hover { background: #fecaca; }
        .perfect-msg { color: #15803d; font-weight: bold; }
    </style>
</head>
<body>

<div class="container">
    <h1>4-Skills English Test: Sports & Free-Time Activities</h1>
    <p class="subtitle">Evaluación integral en Simple Past (Nivel Básico): 1. Speaking & Reading · 2. Reading Comprehension · 3. Listening · 4. Writing.</p>

    <div class="student-box">
        <label for="studentName"><strong>Nombre del estudiante:</strong></label>
        <input type="text" id="studentName" placeholder="Escribe tu nombre completo aquí...">
    </div>

    <!-- SKILL 1: SPEAKING & READING ALOUD -->
    <div class="section-title">Part 1: Reading Aloud & Speaking — Pronunciation Check (2.5 points)</div>
    <p style="color:#475569; margin:8px 0 4px;">Lee cada texto en voz alta y graba tu voz. Al finalizar el examen podrás escuchar y repasar las palabras que necesites mejorar.</p>
    <div id="speaking-container"></div>

    <!-- SKILL 2: READING COMPREHENSION -->
    <div class="section-title">Part 2: Reading Comprehension — Choose the Correct Answer (2.5 points)</div>
    <div class="card" id="reading-container"></div>

    <!-- SKILL 3: LISTENING -->
    <div class="section-title">Part 3: Listening — Dictation & Short Conversations (2.5 points)</div>

    <div class="subsection-title">3A. Listen and write each sentence exactly as you hear it</div>
    <div id="dictation-container"></div>

    <div class="subsection-title">3B. Listen to each conversation and answer the question</div>
    <div class="card" id="dialogues-container"></div>

    <!-- SKILL 4: WRITING -->
    <div class="section-title">Part 4: Writing — My Last Weekend Activities (2.5 points)</div>
    <div class="card">
        <div class="card-header">
            <span class="badge-purple">Writing Task (35 - 70 words)</span>
            <span class="score-pill" id="writing-score-pill">Writing: --%</span>
        </div>
        <div class="prompt-tips">
            <strong>Instructions:</strong> Write a short paragraph about the sports or free-time activities you did last weekend.<br>
            <strong>Include:</strong>
            <ul style="margin:6px 0 0 18px; padding:0;">
                <li>At least <strong>35 words</strong>.</li>
                <li>Time expressions (<em>last Saturday, on Sunday morning, in the afternoon</em>).</li>
                <li>At least <strong>4 verbs in the simple past</strong> (<em>played, went, watched, exercised, swam, visited, stayed, rode</em>).</li>
                <li>Sequence words (<em>First, Then, After that, Finally</em>).</li>
            </ul>
        </div>
        <textarea class="writing-area" id="writingInput" oninput="updateWordCount()" placeholder="Example: Last Saturday morning, I woke up early and went running in the park. Then, I played soccer with my friends..."></textarea>
        <div class="word-counter" id="wordCounter">Palabras escritas: 0 (mínimo recomendado: 35)</div>
        <div class="feedback-box" id="writingFeedback"></div>
    </div>

    <button class="btn-submit" onclick="finishExam()">Finalizar Evaluación y Calcular Nota (0.0 - 10.0)</button>

    <div class="final-summary" id="finalSummary"></div>
</div>

<script>
    // Ponderación equitativa de las 4 habilidades: 2.5 pts c/u = 10.0 pts
    const WEIGHT_SPEAKING = 2.5;
    const WEIGHT_READING = 2.5;
    const WEIGHT_LISTENING = 2.5;
    const WEIGHT_WRITING = 2.5;

    const readingPassages = [
        {
            id: 1,
            title: "1. Carlos — Saturday Soccer Match",
            text: "Last Saturday morning, I played soccer with my friends at the local stadium. We practiced for thirty minutes before the game started. My team scored two goals in the second half, and we won the match. After the game, we drank cold water and ate lunch together."
        },
        {
            id: 2,
            title: "2. Daniela — Hiking in the Mountains",
            text: "On Sunday, my family and I went hiking in the mountains. We woke up at six in the morning and packed fruit and sandwiches. We walked on a quiet trail for two hours and saw many colorful birds. At the top, we took amazing photos and enjoyed the fresh air."
        },
        {
            id: 3,
            title: "3. Luis — Cycling and Swimming",
            text: "Last weekend was very active for me. On Saturday afternoon, I rode my bicycle around the lake for five kilometers. On Sunday morning, I went to the sports center and swam in the pool for forty minutes. I felt tired in the evening, so I went to bed early."
        },
        {
            id: 4,
            title: "4. Andrea — Relaxing Free-Time Activities",
            text: "I didn't play any sports last weekend because it rained a lot. Instead, I stayed home and did fun indoor activities. On Saturday, I painted a picture and listened to music. On Sunday, my cousins visited me, and we played board games and watched an action movie."
        }
    ];

    const comprehensionQuestions = [
        {
            q: "1. What did Carlos and his friends do before the soccer game started?",
            options: [
                "They ate lunch together.",
                "They practiced for thirty minutes.",
                "They went swimming at the sports center."
            ],
            answer: "They practiced for thirty minutes."
        },
        {
            q: "2. How many goals did Carlos's team score?",
            options: [
                "Two goals in the second half.",
                "Three goals in the first half.",
                "They didn't score any goals."
            ],
            answer: "Two goals in the second half."
        },
        {
            q: "3. What did Daniela and her family pack for their hike?",
            options: [
                "Board games and cameras.",
                "Fruit and sandwiches.",
                "Bicycles and water bottles."
            ],
            answer: "Fruit and sandwiches."
        },
        {
            q: "4. Where did Luis ride his bicycle on Saturday afternoon?",
            options: [
                "In the mountains.",
                "Around the lake.",
                "Inside the stadium."
            ],
            answer: "Around the lake."
        },
        {
            q: "5. Why didn't Andrea play sports last weekend?",
            options: [
                "Because she felt sick.",
                "Because she worked all weekend.",
                "Because it rained a lot."
            ],
            answer: "Because it rained a lot."
        },
        {
            q: "6. What did Andrea do with her cousins on Sunday?",
            options: [
                "They played board games and watched an action movie.",
                "They went hiking and took photos.",
                "They swam in the pool for forty minutes."
            ],
            answer: "They played board games and watched an action movie."
        }
    ];

    const dictationSentences = [
        { id: 1, text: "I played basketball with my brother at the park yesterday." },
        { id: 2, text: "She went swimming at the club on Saturday morning." },
        { id: 3, text: "We didn't watch TV because we rode our bikes." },
        { id: 4, text: "They exercised at the gym and listened to music." }
    ];

    const listeningDialogues = [
        {
            id: 1,
            title: "Conversation 1 (Camila & Diego)",
            turns: [
                { speaker: "Camila", line: "Hey Diego! Did you play tennis with Marco yesterday?" },
                { speaker: "Diego", line: "No, the tennis courts were closed. We went to the gym and lifted weights instead." },
                { speaker: "Camila", line: "That sounds great! How long did you stay there?" },
                { speaker: "Diego", line: "We exercised for about an hour and then walked home." }
            ],
            question: "1. Why didn't Diego and Marco play tennis yesterday?",
            options: [
                "Because it started to rain.",
                "Because the tennis courts were closed.",
                "Because Marco forgot his racket."
            ],
            answer: "Because the tennis courts were closed."
        },
        {
            id: 2,
            title: "Conversation 2 (Sofía, Lucas & Emma)",
            turns: [
                { speaker: "Sofía", line: "What did you do in your free time last weekend, Lucas?" },
                { speaker: "Lucas", line: "On Saturday, I stayed home and played video games all afternoon." },
                { speaker: "Emma", line: "Did you go out on Sunday, Lucas?" },
                { speaker: "Lucas", line: "Yes! On Sunday morning, I went running in the park with my dog." }
            ],
            question: "2. What did Lucas do on Sunday morning?",
            options: [
                "He played video games all morning.",
                "He went running in the park with his dog.",
                "He watched a soccer match with Emma."
            ],
            answer: "He went running in the park with his dog."
        },
        {
            id: 3,
            title: "Conversation 3 (Mateo & Valeria)",
            turns: [
                { speaker: "Mateo", line: "Did you enjoy your dance class on Friday evening, Valeria?" },
                { speaker: "Valeria", line: "Yes, I loved it! We practiced salsa steps for ninety minutes." },
                { speaker: "Mateo", line: "Awesome! Are you going again next week?" },
                { speaker: "Valeria", line: "Definitely! My sister wants to join the class too." }
            ],
            question: "3. How long did Valeria practice salsa steps on Friday?",
            options: [
                "For thirty minutes.",
                "For sixty minutes.",
                "For ninety minutes."
            ],
            answer: "For ninety minutes."
        }
    ];

    const pronunciationScores = {};
    const missedWordsByPassage = {};
    let recognition = null;
    let activeId = null;

    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

    function getEnglishVoices() {
        if (!("speechSynthesis" in window)) return [];
        const all = window.speechSynthesis.getVoices();
        const en = all.filter(v => v.lang && v.lang.toLowerCase().startsWith("en"));
        en.sort((a, b) => {
            const scoreA = (a.name.includes("Natural") ? 2 : 0) + (a.name.includes("Google") ? 1 : 0);
            const scoreB = (b.name.includes("Natural") ? 2 : 0) + (b.name.includes("Google") ? 1 : 0);
            return scoreB - scoreA;
        });
        return en.length ? en : all;
    }

    const speakerProfiles = {
        Camila:  { voiceIndex: 0, pitch: 1.14, rateOffset: 0.00 },
        Sofía:   { voiceIndex: 0, pitch: 1.06, rateOffset: 0.02 },
        Emma:    { voiceIndex: 0, pitch: 1.18, rateOffset: -0.02 },
        Valeria: { voiceIndex: 0, pitch: 1.10, rateOffset: 0.00 },
        Diego:   { voiceIndex: 1, pitch: 0.90, rateOffset: 0.00 },
        Lucas:   { voiceIndex: 1, pitch: 0.95, rateOffset: 0.02 },
        Mateo:   { voiceIndex: 2, pitch: 0.86, rateOffset: -0.02 }
    };

    function stopAudio() {
        if ("speechSynthesis" in window) {
            window.speechSynthesis.cancel();
        }
    }

    function speakText(text, rate = 0.95) {
        if (!("speechSynthesis" in window)) {
            alert("Tu navegador no soporta síntesis de voz.");
            return;
        }
        window.speechSynthesis.cancel();
        const voices = getEnglishVoices();
        const utterance = new SpeechSynthesisUtterance(text);
        if (voices.length > 0) utterance.voice = voices[0];
        utterance.lang = "en-US";
        utterance.rate = rate;
        window.speechSynthesis.speak(utterance);
    }

    function playDialogueTurns(dialogueIndex, baseRate = 0.95) {
        if (!("speechSynthesis" in window)) {
            alert("Tu navegador no soporta síntesis de voz.");
            return;
        }
        window.speechSynthesis.cancel();
        const dialogue = listeningDialogues[dialogueIndex];
        const voices = getEnglishVoices();

        dialogue.turns.forEach((turn, idx) => {
            const profile = speakerProfiles[turn.speaker] || { voiceIndex: idx, pitch: 1.0, rateOffset: 0 };
            const utterance = new SpeechSynthesisUtterance(turn.line);
            if (voices.length > 0) {
                utterance.voice = voices[profile.voiceIndex % voices.length];
            }
            utterance.lang = "en-US";
            utterance.pitch = profile.pitch;
            utterance.rate = Math.max(0.65, baseRate + profile.rateOffset);
            window.speechSynthesis.speak(utterance);
        });
    }

    function speakWord(word) {
        speakText(word, 0.85);
    }

    function renderSpeakingCards() {
        const container = document.getElementById("speaking-container");
        readingPassages.forEach(p => {
            pronunciationScores[p.id] = 0;
            missedWordsByPassage[p.id] = [];
            const card = document.createElement("div");
            card.className = "card";
            card.innerHTML = `
                <div class="card-header">
                    <span class="badge">${p.title}</span>
                    <span class="score-pill" id="score-${p.id}">Pronunciación: --%</span>
                </div>
                <div class="target-text">${p.text}</div>
                <div class="controls">
                    <button class="btn-rec" id="rec-${p.id}" onclick="startSpeech(${p.id})">🎤 Grabar lectura</button>
                    <button class="btn-stop" id="stop-${p.id}" onclick="stopSpeech(${p.id})" disabled>⏹️ Detener</button>
                    <span class="live-status" id="status-${p.id}">Listo para grabar</span>
                </div>
                <div class="feedback-box" id="feedback-${p.id}"></div>
            `;
            container.appendChild(card);
        });
    }

    function renderReadingQuestions() {
        const container = document.getElementById("reading-container");
        comprehensionQuestions.forEach((item, idx) => {
            const row = document.createElement("div");
            row.className = "question-row";
            const optionsHtml = item.options.map(opt => `<option value="${opt}">${opt}</option>`).join("");
            row.innerHTML = `
                <strong>${item.q}</strong>
                <select id="q-${idx}">
                    <option value="">-- Selecciona la respuesta correcta --</option>
                    ${optionsHtml}
                </select>
            `;
            container.appendChild(row);
        });
    }

    function renderDictationCards() {
        const container = document.getElementById("dictation-container");
        dictationSentences.forEach(item => {
            const safeText = item.text.replace(/'/g, "\\'");
            const card = document.createElement("div");
            card.className = "card";
            card.innerHTML = `
                <div class="card-header">
                    <span class="badge-blue">Oración ${item.id}</span>
                    <span class="score-pill" id="dict-score-${item.id}">Dictado: --%</span>
                </div>
                <div class="controls">
                    <button class="btn-play" onclick="speakText('${safeText}', 0.95)">🔊 Escuchar oración</button>
                    <button class="btn-slow" onclick="speakText('${safeText}', 0.72)">🐢 Escuchar lento</button>
                    <button class="btn-pause" onclick="stopAudio()">⏹️ Detener</button>
                </div>
                <input type="text" class="dictation-input" id="dict-input-${item.id}" placeholder="Escribe exactamente lo que escuchas...">
                <div class="feedback-box" id="dict-fb-${item.id}"></div>
            `;
            container.appendChild(card);
        });
    }

    function renderDialogueQuestions() {
        const container = document.getElementById("dialogues-container");
        listeningDialogues.forEach((d, idx) => {
            const row = document.createElement("div");
            row.className = "question-row";
            const optionsHtml = d.options.map(opt => `<option value="${opt}">${opt}</option>`).join("");
            row.innerHTML = `
                <div class="card-header" style="margin-bottom:4px;">
                    <span class="badge-blue">${d.title}</span>
                    <div class="controls">
                        <button class="btn-play" onclick="playDialogueTurns(${idx}, 0.95)">🔊 Escuchar conversación</button>
                        <button class="btn-slow" onclick="playDialogueTurns(${idx}, 0.75)">🐢 Lento</button>
                        <button class="btn-pause" onclick="stopAudio()">⏹️ Detener</button>
                    </div>
                </div>
                <strong>${d.question}</strong>
                <select id="dlg-${idx}">
                    <option value="">-- Selecciona la respuesta correcta --</option>
                    ${optionsHtml}
                </select>
            `;
            container.appendChild(row);
        });
    }

    function normalizeWords(str) {
        return str
            .toLowerCase()
            .replace(/[^a-z0-9\s']/g, "")
            .trim()
            .split(/\s+/)
            .filter(Boolean);
    }

    function evaluatePronunciation(passageId, originalText, spokenText) {
        const targetWords = originalText.split(/\s+/);
        const spokenList = normalizeWords(spokenText);
        const spokenSet = new Set(spokenList);

        let matchedCount = 0;
        const missedList = [];

        const highlighted = targetWords.map(rawWord => {
            const clean = rawWord.toLowerCase().replace(/[^a-z0-9']/g, "");
            if (!clean) return rawWord;
            if (spokenSet.has(clean)) {
                matchedCount++;
                return `<span class="word-ok">${rawWord}</span>`;
            } else {
                missedList.push(rawWord.replace(/^[^a-zA-Z0-9']+|[^a-zA-Z0-9']+$/g, ""));
                return `<span class="word-miss">${rawWord}</span>`;
            }
        });

        missedWordsByPassage[passageId] = missedList;

        const totalCleanWords = targetWords.filter(w => w.replace(/[^a-z0-9']/g, "").length > 0).length;
        const accuracy = totalCleanWords > 0 ? (matchedCount / totalCleanWords) : 0;
        pronunciationScores[passageId] = accuracy;

        document.getElementById(`score-${passageId}`).innerText = `Pronunciación: ${Math.round(accuracy * 100)}%`;
        const fb = document.getElementById(`feedback-${passageId}`);
        fb.style.display = "block";
        fb.innerHTML = `
            <div><strong>Retroalimentación palabra por palabra:</strong> ${highlighted.join(" ")}</div>
            <div class="heard-text"><strong>Reconocido por el sistema:</strong> "${spokenText || "No se detectó voz"}"</div>
        `;
    }

    function evaluateDictation() {
        let totalRatio = 0;

        dictationSentences.forEach(item => {
            const userInput = document.getElementById(`dict-input-${item.id}`).value.trim();
            const targetWords = item.text.split(/\s+/);
            const userSet = new Set(normalizeWords(userInput));

            let matched = 0;
            const highlighted = targetWords.map(rawWord => {
                const clean = rawWord.toLowerCase().replace(/[^a-z0-9']/g, "");
                if (!clean) return rawWord;
                if (userSet.has(clean)) {
                    matched++;
                    return `<span class="word-ok">${rawWord}</span>`;
                } else {
                    return `<span class="word-miss">${rawWord}</span>`;
                }
            });

            const cleanCount = targetWords.filter(w => w.replace(/[^a-z0-9']/g, "").length > 0).length;
            const ratio = cleanCount > 0 ? (matched / cleanCount) : 0;
            totalRatio += ratio;

            document.getElementById(`dict-score-${item.id}`).innerText = `Dictado: ${Math.round(ratio * 100)}%`;
            const fb = document.getElementById(`dict-fb-${item.id}`);
            fb.style.display = "block";
            fb.innerHTML = `
                <div><strong>Texto esperado:</strong> ${highlighted.join(" ")}</div>
                <div class="heard-text"><strong>Tu respuesta:</strong> "${userInput || "Sin respuesta"}"</div>
            `;
        });

        return totalRatio / dictationSentences.length;
    }

    function updateWordCount() {
        const text = document.getElementById("writingInput").value.trim();
        const words = text ? text.split(/\s+/).filter(Boolean) : [];
        document.getElementById("wordCounter").innerText = `Palabras escritas: ${words.length} (mínimo recomendado: 35)`;
    }

    function evaluateWriting() {
        const rawText = document.getElementById("writingInput").value.trim();
        const words = normalizeWords(rawText);
        const wordCount = words.length;

        if (wordCount === 0) {
            document.getElementById("writing-score-pill").innerText = "Writing: 0%";
            const fb = document.getElementById("writingFeedback");
            fb.style.display = "block";
            fb.innerHTML = `<strong>Sin texto:</strong> No escribiste ningún párrafo en la sección de Writing.`;
            return 0;
        }

        // 1. Extensión (40%): meta 35 palabras
        const lengthScore = Math.min(1, wordCount / 35) * 0.40;

        // 2. Uso de verbos en pasado simple (40%): meta al menos 4 verbos en pasado
        const commonIrregularPast = new Set([
            "went", "was", "were", "had", "did", "saw", "ate", "drank", "rode",
            "swam", "won", "ran", "woke", "took", "felt", "met", "got", "made",
            "came", "bought", "read", "slept", "wrote", "spent", "found", "gave"
        ]);
        const pastVerbsFound = new Set();
        words.forEach(w => {
            if (commonIrregularPast.has(w) || (w.length > 3 && w.endsWith("ed"))) {
                pastVerbsFound.add(w);
            }
        });
        const verbsScore = Math.min(1, pastVerbsFound.size / 4) * 0.40;

        // 3. Expresiones de tiempo / conectores (20%): meta al menos 2
        const markers = ["last", "yesterday", "saturday", "sunday", "weekend", "first", "then", "after", "finally", "morning", "afternoon", "evening"];
        const markersFound = markers.filter(m => words.includes(m));
        const markersScore = Math.min(1, markersFound.length / 2) * 0.20;

        const totalRatio = lengthScore + verbsScore + markersScore;
        document.getElementById("writing-score-pill").innerText = `Writing: ${Math.round(totalRatio * 100)}%`;

        const fb = document.getElementById("writingFeedback");
        fb.style.display = "block";
        fb.innerHTML = `
            <div><strong>Revisión automática de Writing:</strong></div>
            <ul style="margin:6px 0 0 18px; padding:0; font-size:0.93em;">
                <li><strong>Extensión:</strong> ${wordCount} palabras ${wordCount >= 35 ? "✅" : "(faltan palabras para llegar a 35)"}</li>
                <li><strong>Verbos en pasado detectados (${pastVerbsFound.size}):</strong> ${pastVerbsFound.size > 0 ? Array.from(pastVerbsFound).join(", ") : "Ninguno detectado"}</li>
                <li><strong>Conectores / tiempo detectados (${markersFound.length}):</strong> ${markersFound.length > 0 ? markersFound.join(", ") : "Ninguno detectado"}</li>
            </ul>
        `;
        return totalRatio;
    }

    function startSpeech(id) {
        stopAudio();
        if (!SpeechRecognition) {
            alert("Tu navegador no soporta reconocimiento de voz integrado. Usa Google Chrome o Microsoft Edge.");
            return;
        }
        if (activeId !== null && activeId !== id) {
            stopSpeech(activeId);
        }

        activeId = id;
        let finalTranscript = "";

        recognition = new SpeechRecognition();
        recognition.lang = "en-US";
        recognition.interimResults = true;
        recognition.continuous = true;

        recognition.onresult = (event) => {
            let interim = "";
            for (let i = event.resultIndex; i < event.results.length; i++) {
                const transcript = event.results[i][0].transcript;
                if (event.results[i].isFinal) {
                    finalTranscript += transcript + " ";
                } else {
                    interim += transcript;
                }
            }
            document.getElementById(`status-${id}`).innerHTML = `<span class="recording-active">● Escuchando:</span> ${interim || finalTranscript}`;
        };

        recognition.onerror = (event) => {
            document.getElementById(`status-${id}`).innerText = `Error de micrófono: ${event.error}`;
        };

        recognition.onend = () => {
            const passage = readingPassages.find(p => p.id === id);
            evaluatePronunciation(id, passage.text, finalTranscript.trim());
            document.getElementById(`rec-${id}`).disabled = false;
            document.getElementById(`stop-${id}`).disabled = true;
            document.getElementById(`status-${id}`).innerText = "Grabación guardada y evaluada";
            activeId = null;
        };

        recognition.start();
        document.getElementById(`rec-${id}`).disabled = true;
        document.getElementById(`stop-${id}`).disabled = false;
        document.getElementById(`status-${id}`).innerHTML = `<span class="recording-active">● Grabando... lee en voz alta</span>`;
    }

    function stopSpeech(id) {
        if (recognition && activeId === id) {
            recognition.stop();
        }
    }

    function finishExam() {
        stopAudio();
        const studentName = document.getElementById("studentName").value.trim() || "Estudiante";

        // 1. Speaking / Reading Aloud (2.5 pts)
        const avgSpeakingRatio = Object.values(pronunciationScores).reduce((a, b) => a + b, 0) / readingPassages.length;
        const speakingPoints = avgSpeakingRatio * WEIGHT_SPEAKING;

        // 2. Reading Comprehension (2.5 pts)
        let correctReading = 0;
        comprehensionQuestions.forEach((item, idx) => {
            const selected = document.getElementById(`q-${idx}`).value;
            if (selected === item.answer) correctReading++;
        });
        const readingRatio = correctReading / comprehensionQuestions.length;
        const readingPoints = readingRatio * WEIGHT_READING;

        // 3. Listening (2.5 pts)
        const dictationRatio = evaluateDictation();
        let correctDialogues = 0;
        listeningDialogues.forEach((d, idx) => {
            const selected = document.getElementById(`dlg-${idx}`).value;
            if (selected === d.answer) correctDialogues++;
        });
        const dialoguesRatio = correctDialogues / listeningDialogues.length;
        const listeningRatio = (dictationRatio * 0.5) + (dialoguesRatio * 0.5);
        const listeningPoints = listeningRatio * WEIGHT_LISTENING;

        // 4. Writing (2.5 pts)
        const writingRatio = evaluateWriting();
        const writingPoints = writingRatio * WEIGHT_WRITING;

        // Nota final sobre 10.0
        const finalGrade = (speakingPoints + readingPoints + listeningPoints + writingPoints).toFixed(1);

        // Recopilar palabras mal pronunciadas para el repaso posterior
        const allMissed = [];
        const seen = new Set();
        Object.values(missedWordsByPassage).forEach(list => {
            list.forEach(w => {
                const key = w.toLowerCase();
                if (key && !seen.has(key)) {
                    seen.add(key);
                    allMissed.push(w);
                }
            });
        });

        let reviewHtml = "";
        if (allMissed.length === 0) {
            reviewHtml = `<p class="perfect-msg">¡Excelente trabajo! Pronunciaste correctamente todas las palabras de los textos.</p>`;
        } else {
            const buttonsHtml = allMissed
                .map(word => `<button class="review-word-btn" onclick="speakWord('${word.replace(/'/g, "\\'")}')">🔊 ${word}</button>`)
                .join("");
            reviewHtml = `
                <p><strong>Repaso de Pronunciación (${allMissed.length} palabras guardadas):</strong> Haz clic en cada palabra para escuchar su pronunciación correcta en inglés:</p>
                <div class="review-chips">${buttonsHtml}</div>
            `;
        }

        // Bloquear respuestas tras entregar para mantener la etapa de repaso limpia
        document.querySelectorAll("button.btn-rec, button.btn-stop, select, input.dictation-input, textarea.writing-area").forEach(el => {
            el.disabled = true;
        });

        const summary = document.getElementById("finalSummary");
        summary.style.display = "block";
        summary.innerHTML = `
            <h3>Reporte Final de 4 Habilidades — ${studentName}</h3>
            <div class="grade-banner">
                <div>Calificación Final (Escala 0.0 a 10.0)</div>
                <div class="grade-number">${finalGrade} / 10.0</div>
            </div>
            <div class="grade-breakdown">
                <div class="breakdown-item">
                    <strong>1. Speaking (Pronunciación):</strong><br>
                    ${speakingPoints.toFixed(2)} / ${WEIGHT_SPEAKING.toFixed(1)} pts (${Math.round(avgSpeakingRatio * 100)}%)
                </div>
                <div class="breakdown-item">
                    <strong>2. Reading (Comprensión):</strong><br>
                    ${readingPoints.toFixed(2)} / ${WEIGHT_READING.toFixed(1)} pts (${correctReading}/${comprehensionQuestions.length} aciertos)
                </div>
                <div class="breakdown-item">
                    <strong>3. Listening (Audio):</strong><br>
                    ${listeningPoints.toFixed(2)} / ${WEIGHT_LISTENING.toFixed(1)} pts<br>
                    <small>Dictado: ${Math.round(dictationRatio * 100)}% | Diálogos: ${correctDialogues}/${listeningDialogues.length}</small>
                </div>
                <div class="breakdown-item">
                    <strong>4. Writing (Redacción):</strong><br>
                    ${writingPoints.toFixed(2)} / ${WEIGHT_WRITING.toFixed(1)} pts (${Math.round(writingRatio * 100)}%)
                </div>
            </div>
            <div class="review-section">
                ${reviewHtml}
            </div>
        `;
        summary.scrollIntoView({ behavior: "smooth" });
    }

    if ("speechSynthesis" in window) {
        window.speechSynthesis.onvoiceschanged = () => getEnglishVoices();
    }

    renderSpeakingCards();
    renderReadingQuestions();
    renderDictationCards();
    renderDialogueQuestions();
</script>

